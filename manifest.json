{
  "id": "nora-stars",
  "name": "Stars",
  "version": "1.2.0",
  "description": "Stars for jobs ticked off in a Todoist project this week, a daily streak, and a goal/reward.",
  "author": "Tanya",
  "license": "MIT",
  "minAppVersion": "1.7.1",
  "moduleType": "nora-stars",
  "category": "Personal",
  "icon": "Star",
  "defaultConfig": {
    "name": "Nora",
    "projectName": "Nora",
    "weeklyGoal": 15,
    "reward": "Movie night",
    "weekStart": 1,
    "accentColor": "#db2777"
  },
  "defaultSize": {
    "w": 1000,
    "h": 360
  },
  "defaultStyle": {
    "fontSize": 18,
    "padding": 28,
    "borderRadius": 28
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "title": "Whose stars",
        "ui:widget": "text",
        "ui:group": "Content"
      },
      "projectName": {
        "type": "string",
        "title": "Todoist project",
        "ui:widget": "text",
        "ui:group": "Content"
      },
      "weeklyGoal": {
        "type": "number",
        "title": "Weekly goal",
        "ui:widget": "slider",
        "ui:group": "Content",
        "minimum": 3,
        "maximum": 40,
        "ui:step": 1
      },
      "reward": {
        "type": "string",
        "title": "Reward",
        "ui:widget": "text",
        "ui:group": "Content"
      },
      "weekStart": {
        "type": "number",
        "title": "Week starts (0=Sun, 1=Mon)",
        "ui:widget": "slider",
        "ui:group": "Content",
        "minimum": 0,
        "maximum": 1,
        "ui:step": 1
      },
      "accentColor": {
        "type": "string",
        "title": "Accent colour",
        "ui:widget": "color",
        "ui:group": "Look"
      }
    }
  },
  "exports": {
    "component": "default"
  },
  "dataRequirements": [],
  "prefetchUrl": null,
  "permissions": [
    "network",
    "secrets",
    "storage"
  ],
  "secrets": [
    {
      "key": "todoist_token",
      "label": "Todoist API token",
      "description": "Todoist \u2192 Settings \u2192 Integrations \u2192 Developer \u2192 API token.",
      "required": true,
      "placeholder": "Your Todoist API token"
    }
  ],
  "allowedDomains": [
    "api.todoist.com"
  ]
}